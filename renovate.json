{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "enabled": true,
      "schedule": [
        "after 9pm on saturday"
      ],
      "matchManagers": [
        "helmv3",
        "dockerfile",
        "github-actions",
        "pre-commit"
      ],
      "additionalBranchPrefix": "{{packageFileDir}}-",
      "groupName": "all-updates"
    }
  ],
  "helmv3": {
    "enabled": true
  },
  "dockerfile": {
    "enabled": true
  }
}
